  <script>
    const table = document.getElementById('coverageTable');
    const tbody = table.querySelector('tbody');
    const clearButton = document.getElementById('clearButton');
    const status = document.getElementById('status');
    const timerButton = document.getElementById('timerButton');
    const timerDisplay = document.getElementById('timerDisplay');

    let timerInterval = null;
    let timeLeft = 360;

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins}:${secs < 10 ? '0' + secs : secs}`;
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timeLeft = 360;
      timerDisplay.textContent = formatTime(timeLeft);
      timerInterval = setInterval(() => {
        timeLeft--;
        timerDisplay.textContent = formatTime(timeLeft);
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          timerInterval = null;
          timerButton.textContent = 'Start 6 Min Timer';
          status.textContent = 'Timer expired – time to assign!';
        }
      }, 1000);
      timerButton.textContent = 'Reset Timer';
    }

    function resetTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      timeLeft = 360;
      timerDisplay.textContent = formatTime(timeLeft);
      timerButton.textContent = 'Start 6 Min Timer';
    }

    timerButton.addEventListener('click', () => {
      if (timerInterval) {
        resetTimer();
      } else {
        startTimer();
      }
    });

    // Find the insertion point for bottom of section
    function getSectionEnd(row) {
      let next = row.nextElementSibling;
      while (next && !next.classList.contains('section-header')) {
        next = next.nextElementSibling;
      }
      return next || null;
    }

    table.addEventListener('click', (e) => {
      const btn = e.target;
      const row = btn.closest('tr');

      if (!row || row.classList.contains('section-header')) return;

      if (btn.classList.contains('avail-btn')) {
        const isAvailable = row.classList.toggle('available');
        btn.textContent = isAvailable ? 'Marked Available' : 'Available';
        btn.classList.toggle('active', isAvailable);
        row.querySelector('.assign-btn').disabled = !isAvailable;
        status.textContent = isAvailable 
          ? `Marked available: ${row.cells[0].textContent.trim()}` 
          : '';
      } 
      else if (btn.classList.contains('assign-btn') && !btn.disabled) {
        const name = row.cells[0].textContent.trim();
        row.classList.add('assigned');
        btn.disabled = true;
        btn.textContent = 'Assigned';
        status.textContent = `Assigned coverage to: ${name}`;

        // Move assigned person to bottom of their section
        const sectionEnd = getSectionEnd(row);
        if (sectionEnd) {
          tbody.insertBefore(row, sectionEnd);
        } else {
          tbody.appendChild(row);
        }
      }
    });

    clearButton.addEventListener('click', () => {
      const rows = Array.from(tbody.querySelectorAll('tr:not(.section-header)'));

      // Only reset visual states — do NOT reorder rows
      rows.forEach(row => {
        row.classList.remove('available', 'assigned');
        const availBtn = row.querySelector('.avail-btn');
        availBtn.textContent = 'Available';
        availBtn.classList.remove('active');
        const assignBtn = row.querySelector('.assign-btn');
        assignBtn.disabled = true;
        assignBtn.textContent = 'Assign';
      });

      status.textContent = 'Availability highlights cleared. Assigned members remain at bottom of their roster.';
    });
  </script>
